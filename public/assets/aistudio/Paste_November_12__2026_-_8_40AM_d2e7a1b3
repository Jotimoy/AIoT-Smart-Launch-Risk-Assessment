void loadSavedData() {
  preferences.begin("launch", true);

  waterDryRaw = preferences.getInt("waterDry", -1);
  waterWetRaw = preferences.getInt("waterWet", -1);

  totalEntries = preferences.getUInt("entries", 0);
  totalExits = preferences.getUInt("exits", 0);
  passengerCount = preferences.getUInt("passengers", 0);
  unmatchedExitEvents = preferences.getUInt("unmatched", 0);

  preferences.end();

  waterDryReferenceValid = (waterDryRaw >= 0);
  waterCalibrationValid =
      (waterDryRaw >= 0) &&
      (waterWetRaw >= 0) &&
      (abs(waterWetRaw - waterDryRaw) >= 50);
}

void saveWaterDryReference() {
  preferences.begin("launch", false);
  preferences.putInt("waterDry", waterDryRaw);
  preferences.remove("waterWet");
  preferences.end();
}

void saveWaterCalibration() {
  preferences.begin("launch", false);
  preferences.putInt("waterDry", waterDryRaw);
  preferences.putInt("waterWet", waterWetRaw);
  preferences.end();
}

void savePassengerCounts() {
  preferences.begin("launch", false);
  preferences.putUInt("entries", totalEntries);
  preferences.putUInt("exits", totalExits);
  preferences.putUInt("passengers", passengerCount);
  preferences.putUInt("unmatched", unmatchedExitEvents);
  preferences.end();
}

// ============================================================
// BUZZER CONTROL
// GPIO27 drives an NPN transistor through a 1k resistor.
// ============================================================

void setBuzzer(bool enabled) {
  if (!ENABLE_BUZZER) return;

  if (BUZZER_ACTIVE_LOW) {
    digitalWrite(BUZZER_PIN, enabled ? LOW : HIGH);
  } else {
    digitalWrite(BUZZER_PIN, enabled ? HIGH : LOW);
  }
}

void updateBuzzer(bool criticalAlert,
                  bool warningAlert,
                  bool waterDetected) {
  const unsigned long now = millis();
  bool buzzerOn = false;

  if (criticalAlert) {
    // Continuous tone for a critical prototype alert.
    buzzerOn = true;
    buzzerStatus = "CRITICAL - CONTINUOUS";
  }
  else if (warningAlert) {
    // Two short beeps each second.
    const unsigned long phase = now % 1000UL;
    buzzerOn = (phase < 150UL) ||
               (phase >= 300UL && phase < 450UL);
    buzzerStatus = "WARNING - DOUBLE BEEP";
  }
  else if (waterDetected) {
    // One short beep every 2.5 seconds.
    const unsigned long phase = now % 2500UL;
    buzzerOn = (phase < 120UL);
    buzzerStatus = "WATER DETECTED - BEEP";
  }
  else {
    buzzerOn = false;
    buzzerStatus = "OFF";
  }

  setBuzzer(buzzerOn);
}

// ============================================================
// WATER SENSOR
// The displayed percentage is relative wetted-track coverage,
// NOT litres or the percentage of the hull filled with water.
// ============================================================

int readWaterRawAverage() {
  long total = 0;
  const uint8_t samples = 16;

  for (uint8_t i = 0; i < samples; i++) {
    total += analogRead(WATER_ANALOG_PIN);
    delayMicroseconds(300);
  }

  return (int)(total / samples);
}

void calibrateWaterDry() {
  Serial.println();
  Serial.println("Water dry calibration: keep sensor fully dry.");

  waterRaw = readWaterRawAverage();
  waterDryRaw = waterRaw;
  waterDryReferenceValid = true;
  waterCalibrationValid = false;
  waterCoveragePercent = 0.0;

  saveWaterDryReference();

  Serial.print("Saved DRY ADC value: ");
  Serial.println(waterDryRaw);
  Serial.println("Now wet the sensing tracks and send 'w'.");
}

void calibrateWaterWet() {
  if (!waterDryReferenceValid) {
    Serial.println("Water calibration error: send 'd' first while dry.");
    return;
  }

  Serial.println();
  Serial.println("Wet only the sensing tracks; keep connector/electronics dry.");

  waterRaw = readWaterRawAverage();
  waterWetRaw = waterRaw;

  Serial.print("DRY ADC: ");
  Serial.println(waterDryRaw);
  Serial.print("WET ADC: ");
  Serial.println(waterWetRaw);

  if (abs(waterWetRaw - waterDryRaw) < 50) {
    waterCalibrationValid = false;
    Serial.println("Water calibration FAILED: dry/wet difference is too small.");
    Serial.println("Check wiring, supply, and that the sensing tracks are wet.");
    return;
  }

  waterCalibrationValid = true;
  saveWaterCalibration();

  Serial.println("Water calibration successful and saved in ESP32 flash.");
}

void updateWaterSensor() {
  const unsigned long now = millis();
  if (now - lastWaterReadMs < WATER_READ_INTERVAL_MS) return;

  lastWaterReadMs = now;
  waterRaw = readWaterRawAverage();

  if (!waterCalibrationValid) {
    waterCoveragePercent = 0.0;
    return;
  }

  // Signed denominator supports either ADC direction (wet may be
  // higher or lower than dry depending on the board and water).
  const float denominator = (float)(waterWetRaw - waterDryRaw);
  if (fabs(denominator) < 1.0) {
    waterCalibrationValid = false;
    waterCoveragePercent = 0.0;
    return;
  }

  waterCoveragePercent =
      ((float)(waterRaw - waterDryRaw) / denominator) * 100.0;

  if (waterCoveragePercent < 0.0) waterCoveragePercent = 0.0;
  if (waterCoveragePercent > 100.0) waterCoveragePercent = 100.0;
}

// ============================================================
// MPU6050
// Direct register method matching the user's working test code.
// ============================================================

void writeMPURegister(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(MPU_ADDRESS);
  Wire.write(reg);
  Wire.write(value);
  Wire.endTransmission(true);
}

bool initializeMPU() {
  Wire.begin(MPU_SDA_PIN, MPU_SCL_PIN);

  Wire.beginTransmission(MPU_ADDRESS);
  if (Wire.endTransmission() != 0) {
    return false;
  }

  // Wake up MPU6050.
  writeMPURegister(0x6B, 0x00);
  delay(100);

  // Accelerometer +/-2g.
  writeMPURegister(0x1C, 0x00);

  // Gyroscope +/-250 degrees/second.
  writeMPURegister(0x1B, 0x00);

  // Digital low-pass filter.
  writeMPURegister(0x1A, 0x03);
  delay(100);

  return true;
}

bool readMPU6050(float &currentPitch,
                 float &currentRoll,
                 float &currentGyroX,
                 float &currentGyroY) {
  Wire.beginTransmission(MPU_ADDRESS);
  Wire.write(0x3B);

  if (Wire.endTransmission(false) != 0) {
    return false;
  }

  const uint8_t received = Wire.requestFrom(
      (uint8_t)MPU_ADDRESS,
      (uint8_t)14,
      (uint8_t)true
  );

  if (received != 14) {
    while (Wire.available()) Wire.read();
    return false;
  }

  accelXRaw = (int16_t)((Wire.read() << 8) | Wire.read());
  accelYRaw = (int16_t)((Wire.read() << 8) | Wire.read());
  accelZRaw = (int16_t)((Wire.read() << 8) | Wire.read());
  temperatureRaw = (int16_t)((Wire.read() << 8) | Wire.read());
  gyroXRaw = (int16_t)((Wire.read() << 8) | Wire.read());
  gyroYRaw = (int16_t)((Wire.read() << 8) | Wire.read());
  gyroZRaw = (int16_t)((Wire.read() << 8) | Wire.read());

  const float ax = accelXRaw / 16384.0f;
  const float ay = accelYRaw / 16384.0f;
  const float az = accelZRaw / 16384.0f;

  currentPitch = atan2f(-ax, sqrtf(ay * ay + az * az)) * 180.0f / PI;
  currentRoll = atan2f(ay, az) * 180.0f / PI;

  // At +/-250 deg/s, sensitivity is 131 LSB/(deg/s).
  currentGyroX = gyroXRaw / 131.0f;
  currentGyroY = gyroYRaw / 131.0f;

  return true;
}

float normalizeAngle(float angle) {
  while (angle > 180.0f) angle -= 360.0f;
  while (angle < -180.0f) angle += 360.0f;
  return angle;
}

bool calibrateMPULevel() {
  Serial.println();
  Serial.println("MPU calibration: keep the model level and completely still.");

  float pitchSum = 0.0f;
  float rollSum = 0.0f;
  float gyroXSum = 0.0f;
  float gyroYSum = 0.0f;
  uint16_t validSamples = 0;

  for (uint16_t i = 0; i < 100; i++) {
    float p, r, gx, gy;
    if (readMPU6050(p, r, gx, gy)) {
      pitchSum += p;
      rollSum += r;
      gyroXSum += gx;
      gyroYSum += gy;
      validSamples++;
    }
    delay(10);
  }

  if (validSamples < 80) {
    Serial.println("MPU calibration FAILED: too few valid samples.");
    return false;
  }

  pitchZeroOffsetDeg = pitchSum / validSamples;
  rollZeroOffsetDeg = rollSum / validSamples;
  gyroXZeroOffsetDps = gyroXSum / validSamples;
  gyroYZeroOffsetDps = gyroYSum / validSamples;

  pitchDeg = 0.0f;
  rollDeg = 0.0f;
  gyroXRateDps = 0.0f;
  gyroYRateDps = 0.0f;

  Serial.println("MPU level and gyro bias calibration complete.");
  Serial.print("Pitch zero offset: ");
  Serial.println(pitchZeroOffsetDeg, 2);
  Serial.print("Roll zero offset: ");
  Serial.println(rollZeroOffsetDeg, 2);
  Serial.print("Gyro X bias: ");
  Serial.println(gyroXZeroOffsetDps, 2);
  Serial.print("Gyro Y bias: ");
  Serial.println(gyroYZeroOffsetDps, 2);

  return true;
}

void updateMPU() {
  float rawPitch, rawRoll, rawGyroX, rawGyroY;

  mpuValid = readMPU6050(rawPitch, rawRoll, rawGyroX, rawGyroY);

  if (mpuValid) {
    pitchDeg = normalizeAngle(rawPitch - pitchZeroOffsetDeg);
    rollDeg = normalizeAngle(rawRoll - rollZeroOffsetDeg);
    gyroXRateDps = rawGyroX - gyroXZeroOffsetDps;
    gyroYRateDps = rawGyroY - gyroYZeroOffsetDps;
    lastMpuReadMs = millis();
  }
  else if (millis() - lastMpuReadMs > 1000UL) {
    mpuValid = false;
  }
}

// ============================================================
// GPS NEO-6M
