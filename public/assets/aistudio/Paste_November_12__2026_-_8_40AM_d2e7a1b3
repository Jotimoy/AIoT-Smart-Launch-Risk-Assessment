void updateGPS() {
  // Keep parsing continuously so the UART receive buffer does not fill.
  while (gpsSerial.available() > 0) {
    gps.encode((char)gpsSerial.read());
  }

  gpsFixValid = gps.location.isValid() && (gps.location.age() < 5000UL);
}

// ============================================================
// HC-SR04 ULTRASONIC DISTANCE
// ============================================================

float readUltrasonicDistanceCm(uint8_t trigPin, uint8_t echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(3);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);

  const unsigned long duration = pulseIn(
      echoPin,
      HIGH,
      ULTRASONIC_TIMEOUT_US
  );

  if (duration == 0) {
    return -1.0f; // No echo / no object in measurable range.
  }

  return duration / 58.0f;
}

void recordEntryEvent() {
  totalEntries++;
  passengerCount++;
  savePassengerCounts();

  Serial.println();
  Serial.println("*** ENTRY DETECTED: PASSENGER +1 ***");
  Serial.print("Total entries: ");
  Serial.println(totalEntries);
  Serial.print("Passengers currently onboard: ");
  Serial.println(passengerCount);
}

void recordExitEvent() {
  totalExits++;

  if (passengerCount > 0) {
    passengerCount--;
  } else {
    // Exit event was detected while stored onboard count was zero.
    // This avoids unsigned underflow and keeps the count at zero.
    unmatchedExitEvents++;
  }

  savePassengerCounts();

  Serial.println();
  Serial.println("*** EXIT DETECTED: PASSENGER -1 (IF COUNT > 0) ***");
  Serial.print("Total exits: ");
  Serial.println(totalExits);
  Serial.print("Passengers currently onboard: ");
  Serial.println(passengerCount);
}

void processGateDetector(GateDetector &gate,
                         float distanceCm,
                         bool isEntryGate) {
  if (gate.armed) {
    // Require two consecutive near readings to reduce false triggers.
    if (distanceCm >= 2.0f && distanceCm <= GATE_DETECT_DISTANCE_CM) {
      if (gate.nearSamples < 255) gate.nearSamples++;
    } else {
      gate.nearSamples = 0;
    }

    if (gate.nearSamples >= 2) {
      gate.armed = false;
      gate.nearSamples = 0;
      gate.clearSamples = 0;

      if (isEntryGate) {
        recordEntryEvent();
      } else {
        recordExitEvent();
      }
    }
  }
  else {
    // Re-arm only after the target has moved away.
    if (distanceCm < 0.0f || distanceCm >= GATE_CLEAR_DISTANCE_CM) {
      if (gate.clearSamples < 255) gate.clearSamples++;
    } else {
      gate.clearSamples = 0;
    }

    if (gate.clearSamples >= 3) {
      gate.armed = true;
      gate.clearSamples = 0;
      gate.nearSamples = 0;
    }
  }
}

void updatePassengerGates() {
  const unsigned long now = millis();
  if ((int32_t)(now - nextGatePingAtMs) < 0) return;

  if (nextGatePing == PING_ENTRY) {
    entryDistanceCm = readUltrasonicDistanceCm(
        ENTRY_TRIG_PIN,
        ENTRY_ECHO_PIN
    );

    processGateDetector(entryGate, entryDistanceCm, true);
    nextGatePing = PING_EXIT;
  }
  else {
    exitDistanceCm = readUltrasonicDistanceCm(
        EXIT_TRIG_PIN,
        EXIT_ECHO_PIN
    );

    processGateDetector(exitGate, exitDistanceCm, false);
    nextGatePing = PING_ENTRY;
  }

  // Leave a minimum quiet gap between the two ultrasonic pings.
  nextGatePingAtMs = millis() + GATE_PING_GAP_MS;
}

// ============================================================
// SERIAL COMMANDS
// d = dry water calibration
// w = wet water calibration
// t = tare both load cells
// m = recalibrate MPU level (model must be level and still)
// z = reset passenger counters
// ============================================================

void handleSerialCommands() {
  while (Serial.available() > 0) {
    const char command = (char)Serial.read();

    if (command == '\n' || command == '\r') continue;

    if (command == 'd' || command == 'D') {
      setBuzzer(false);
      calibrateWaterDry();
    }
    else if (command == 'w' || command == 'W') {
      setBuzzer(false);
      calibrateWaterWet();
    }
    else if (command == 't' || command == 'T') {
      Serial.println("Taring both load cells. Remove all weight first.");

      if (leftScale.wait_ready_timeout(3000) &&
          rightScale.wait_ready_timeout(3000)) {
        leftScale.tare(20);
        rightScale.tare(20);
        leftWeightG = 0.0f;
        rightWeightG = 0.0f;
        lastLeftScaleReadMs = millis();
        lastRightScaleReadMs = millis();
        Serial.println("Both load cells tared.");
      } else {
        Serial.println("Tare failed: check HX711 connections.");
      }
    }
    else if (command == 'm' || command == 'M') {
      setBuzzer(false);
      calibrateMPULevel();
    }
    else if (command == 'z' || command == 'Z') {
      totalEntries = 0;
      totalExits = 0;
      passengerCount = 0;
      unmatchedExitEvents = 0;

      entryGate.armed = true;
      entryGate.nearSamples = 0;
      entryGate.clearSamples = 0;
      exitGate.armed = true;
      exitGate.nearSamples = 0;
      exitGate.clearSamples = 0;

      savePassengerCounts();
      Serial.println("Passenger counters reset to zero and saved.");
    }
  }
}

// ============================================================
// SERIAL MONITOR OUTPUT
// ============================================================

void printMonitoringData() {
  const unsigned long now = millis();
  if (now - lastOutputMs < OUTPUT_INTERVAL_MS) return;
  lastOutputMs = now;

  const float totalWeightG = leftWeightG + rightWeightG;
  const float weightDifferenceG = fabs(leftWeightG - rightWeightG);

  float leftLoadPercent = 0.0f;
  float rightLoadPercent = 0.0f;
  float imbalancePercent = 0.0f;

  const bool validDistribution =
      leftScaleValid && rightScaleValid &&
      leftWeightG >= 0.0f && rightWeightG >= 0.0f &&
      totalWeightG >= NO_LOAD_THRESHOLD_G;

  if (validDistribution) {
    leftLoadPercent = (leftWeightG / totalWeightG) * 100.0f;
    rightLoadPercent = (rightWeightG / totalWeightG) * 100.0f;
    imbalancePercent = (weightDifferenceG / totalWeightG) * 100.0f;
  }

  const char *balanceStatus;
  if (!leftScaleValid || !rightScaleValid) {
    balanceStatus = "SENSOR ERROR";
  }
  else if (leftWeightG < 0.0f || rightWeightG < 0.0f) {
    balanceStatus = "CHECK LOAD CELL";
  }
  else if (totalWeightG < NO_LOAD_THRESHOLD_G) {
    balanceStatus = "NO LOAD";
  }
  else if (imbalancePercent >= IMBALANCE_CRITICAL_PERCENT) {
    balanceStatus = "HIGH IMBALANCE";
  }
  else if (imbalancePercent >= IMBALANCE_WARNING_PERCENT) {
    balanceStatus = "IMBALANCE WARNING";
  }
  else {
    balanceStatus = "BALANCED";
  }

  const float absRoll = fabs(rollDeg);
  const float absPitch = fabs(pitchDeg);

  const char *tiltStatus;
  if (!mpuValid) {
    tiltStatus = "IMU ERROR";
  }
  else if (absRoll >= TILT_CRITICAL_DEG || absPitch >= TILT_CRITICAL_DEG) {
    tiltStatus = "HIGH TILT";
  }
  else if (absRoll >= TILT_WARNING_DEG || absPitch >= TILT_WARNING_DEG) {
    tiltStatus = "TILT WARNING";
  }
  else {
    tiltStatus = "NORMAL";
  }

  const char *waterStatus;
  if (!waterCalibrationValid) {
    waterStatus = "NOT CALIBRATED";
  }
  else if (waterCoveragePercent < WATER_DETECT_PERCENT) {
    waterStatus = "DRY";
  }
  else if (waterCoveragePercent < WATER_WARNING_PERCENT) {
    waterStatus = "WATER DETECTED";
  }
  else if (waterCoveragePercent < WATER_CRITICAL_PERCENT) {
    waterStatus = "WATER WARNING";
  }
  else {
    waterStatus = "HIGH WATER";
  }

  const bool capacityReached = leftScaleValid && rightScaleValid &&
      (leftWeightG >= LOAD_CELL_CAPACITY_G ||
       rightWeightG >= LOAD_CELL_CAPACITY_G);

  const bool nearCapacity = leftScaleValid && rightScaleValid &&
      (leftWeightG >= LOAD_CELL_WARNING_G ||
       rightWeightG >= LOAD_CELL_WARNING_G);

  const bool detectedWater = waterCalibrationValid &&
      (waterCoveragePercent >= WATER_DETECT_PERCENT);

  const bool warningWater = waterCalibrationValid &&
      (waterCoveragePercent >= WATER_WARNING_PERCENT);

  const bool criticalWater = waterCalibrationValid &&
      (waterCoveragePercent >= WATER_CRITICAL_PERCENT);

  const bool warningTilt = mpuValid &&
      (absRoll >= TILT_WARNING_DEG || absPitch >= TILT_WARNING_DEG);

  const bool criticalTilt = mpuValid &&
      (absRoll >= TILT_CRITICAL_DEG || absPitch >= TILT_CRITICAL_DEG);

  const bool warningImbalance = validDistribution &&
      (imbalancePercent >= IMBALANCE_WARNING_PERCENT);

  const bool criticalImbalance = validDistribution &&
      (imbalancePercent >= IMBALANCE_CRITICAL_PERCENT);

  const bool criticalAlert = criticalWater || criticalTilt ||
      criticalImbalance || capacityReached;

  const bool warningAlert = warningWater || warningTilt ||
      warningImbalance || nearCapacity;

  // Buzzer is updated in loop() independently; this output reports its mode.
  const char *capacityStatus;
  if (!leftScaleValid || !rightScaleValid) {
    capacityStatus = "SENSOR ERROR";
  }
  else if (capacityReached) {
    capacityStatus = "CAPACITY REACHED";
  }
  else if (nearCapacity) {
    capacityStatus = "NEAR CAPACITY";
  }
  else {
    capacityStatus = "WITHIN NOMINAL CAPACITY";
  }

  const char *overallStatus;
  if (!leftScaleValid || !rightScaleValid || !mpuValid) {
    overallStatus = "SENSOR DATA ERROR";
  }
  else if (leftWeightG < 0.0f || rightWeightG < 0.0f) {
    overallStatus = "CHECK WEIGHT SENSORS";
  }
  else if (capacityReached) {
    overallStatus = "LOAD CELL LIMIT";
  }
  else if (!waterCalibrationValid) {
    overallStatus = "WATER CALIBRATION NEEDED";
  }
  else if (criticalAlert) {
    overallStatus = "HIGH ALERT - PROTOTYPE";
  }
  else if (warningAlert || detectedWater) {
    overallStatus = "WARNING - PROTOTYPE";
  }
  else {
    overallStatus = "NORMAL - PROTOTYPE";
  }

  Serial.println();
  Serial.println("================================================");
  Serial.println("       AIoT SMART LAUNCH RISK ASSESSMENT");
  Serial.println("================================================");

  // Weight monitoring
  Serial.println("[WEIGHT MONITORING]");
  Serial.print("Left Weight       : "); Serial.print(leftWeightG, 2); Serial.println(" g");
  Serial.print("Right Weight      : "); Serial.print(rightWeightG, 2); Serial.println(" g");
  Serial.print("Total Weight      : "); Serial.print(totalWeightG, 2); Serial.println(" g");
  Serial.print("Weight Difference : "); Serial.print(weightDifferenceG, 2); Serial.println(" g");

  if (validDistribution) {
    Serial.print("Left Load Share   : "); Serial.print(leftLoadPercent, 1); Serial.println(" %");
    Serial.print("Right Load Share  : "); Serial.print(rightLoadPercent, 1); Serial.println(" %");
    Serial.print("Imbalance         : "); Serial.print(imbalancePercent, 1); Serial.println(" %");
  } else {
    Serial.println("Load Distribution: Not available / no load");
  }
  Serial.print("Balance Status    : "); Serial.println(balanceStatus);

  // MPU monitoring
  Serial.println("------------------------------------------------");
  Serial.println("[MPU6050 TILT MONITORING]");
  if (mpuValid) {
    Serial.print("Pitch             : "); Serial.print(pitchDeg, 2); Serial.println(" deg");
    Serial.print("Roll              : "); Serial.print(rollDeg, 2); Serial.println(" deg");
    Serial.print("Gyro X Rate       : "); Serial.print(gyroXRateDps, 2); Serial.println(" deg/s");
    Serial.print("Gyro Y Rate       : "); Serial.print(gyroYRateDps, 2); Serial.println(" deg/s");
  } else {
    Serial.println("MPU6050: NO VALID DATA");
  }
  Serial.print("Tilt Status       : "); Serial.println(tiltStatus);

  // Water monitoring
  Serial.println("------------------------------------------------");
  Serial.println("[INTERNAL WATER MONITORING]");
  Serial.print("Water ADC         : "); Serial.println(waterRaw);
  if (waterCalibrationValid) {
    Serial.print("Track Coverage    : "); Serial.print(waterCoveragePercent, 1); Serial.println(" % (approx.)");
  } else {
    Serial.println("Track Coverage    : Calibration required");
  }
  Serial.print("Water Status      : "); Serial.println(waterStatus);

  // GPS monitoring
  Serial.println("------------------------------------------------");
  Serial.println("[GPS LOCATION MONITORING]");
  if (gpsFixValid) {
    Serial.println("GPS Status        : FIXED");
    Serial.print("Latitude          : "); Serial.println(gps.location.lat(), 6);
    Serial.print("Longitude         : "); Serial.println(gps.location.lng(), 6);

    Serial.print("Speed             : ");
    if (gps.speed.isValid()) {
      Serial.print(gps.speed.kmph(), 2); Serial.println(" km/h");
    } else {
      Serial.println("N/A");
    }

    Serial.print("Altitude          : ");
    if (gps.altitude.isValid()) {
      Serial.print(gps.altitude.meters(), 2); Serial.println(" m");
    } else {
      Serial.println("N/A");
    }

    Serial.print("Satellites        : ");
    if (gps.satellites.isValid()) Serial.println(gps.satellites.value());
    else Serial.println("N/A");

    Serial.print("Google Maps       : https://maps.google.com/?q=");
    Serial.print(gps.location.lat(), 6);
    Serial.print(",");
    Serial.println(gps.location.lng(), 6);
  } else {
    Serial.println("GPS Status        : WAITING FOR FIX");
    if (gps.satellites.isValid()) {
      Serial.print("Satellites        : "); Serial.println(gps.satellites.value());
    }
    Serial.print("GPS Characters    : "); Serial.println(gps.charsProcessed());
  }

  // Passenger counting
  Serial.println("------------------------------------------------");
  Serial.println("[PASSENGER MONITORING]");
  Serial.print("Entry Distance    : ");
  if (entryDistanceCm >= 0.0f) { Serial.print(entryDistanceCm, 1); Serial.println(" cm"); }
  else { Serial.println("No echo / clear"); }

  Serial.print("Exit Distance     : ");
  if (exitDistanceCm >= 0.0f) { Serial.print(exitDistanceCm, 1); Serial.println(" cm"); }
  else { Serial.println("No echo / clear"); }

  Serial.print("Total Entries     : "); Serial.println(totalEntries);
  Serial.print("Total Exits       : "); Serial.println(totalExits);
  Serial.print("Passengers Aboard : "); Serial.println(passengerCount);
  Serial.print("Unmatched Exits   : "); Serial.println(unmatchedExitEvents);

  // Buzzer and overall status
  Serial.println("------------------------------------------------");
  Serial.println("[ALERT MONITORING]");
  Serial.print("Capacity Status   : "); Serial.println(capacityStatus);
  Serial.print("Buzzer Status     : "); Serial.println(buzzerStatus);
  Serial.print("OVERALL STATUS    : "); Serial.println(overallStatus);
  Serial.println("================================================");
}

// ============================================================
// SETUP
// ============================================================

void setup() {
  Serial.begin(115200);
  delay(1000);

  Serial.println();
  Serial.println("================================================");
  Serial.println(" AIoT SMART LAUNCH RISK ASSESSMENT - STARTING");
  Serial.println("================================================");

  // Buzzer output must be LOW at startup.
  pinMode(BUZZER_PIN, OUTPUT);
  setBuzzer(false);

  // Water ADC setup.
  analogReadResolution(12);
  analogSetPinAttenuation(WATER_ANALOG_PIN, ADC_11db);

  // HC-SR04 pin setup.
  pinMode(ENTRY_TRIG_PIN, OUTPUT);
  pinMode(ENTRY_ECHO_PIN, INPUT);
  pinMode(EXIT_TRIG_PIN, OUTPUT);
  pinMode(EXIT_ECHO_PIN, INPUT);
  digitalWrite(ENTRY_TRIG_PIN, LOW);
  digitalWrite(EXIT_TRIG_PIN, LOW);

  // Load saved water calibration and passenger counters.
  loadSavedData();

  Serial.println("Saved passenger data loaded.");
  Serial.print("Passengers at startup: ");
  Serial.println(passengerCount);

  // GPS UART2. GPS TX must connect to ESP32 RX GPIO16.
  gpsSerial.begin(9600, SERIAL_8N1, GPS_RX_PIN, GPS_TX_PIN);
  Serial.println("GPS UART2 initialized at 9600 baud.");

  // MPU6050 setup.
  Serial.println("Initializing MPU6050...");
  if (!initializeMPU()) {
    Serial.println("FATAL ERROR: MPU6050 not detected at address 0x68.");
    Serial.println("Check SDA=21, SCL=22, 3.3V, GND, and AD0.");
    while (true) {
      setBuzzer(false);
      delay(1000);
    }
  }
  Serial.println("MPU6050 connected.");

  // HX711 setup.
  leftScale.begin(LEFT_DT_PIN, LEFT_SCK_PIN);
  rightScale.begin(RIGHT_DT_PIN, RIGHT_SCK_PIN);

  Serial.println("Connecting left HX711...");
  if (!leftScale.wait_ready_timeout(4000)) {
    Serial.println("FATAL ERROR: Left HX711 not ready. Check wiring.");
    while (true) {
      setBuzzer(false);
      delay(1000);
    }
  }

  Serial.println("Connecting right HX711...");
  if (!rightScale.wait_ready_timeout(4000)) {
    Serial.println("FATAL ERROR: Right HX711 not ready. Check wiring.");
    while (true) {
      setBuzzer(false);
      delay(1000);
    }
  }

  leftScale.set_scale(LEFT_CALIBRATION_FACTOR);
  rightScale.set_scale(RIGHT_CALIBRATION_FACTOR);

  // Calibrate MPU with model level and still.
  if (!calibrateMPULevel()) {
    Serial.println("FATAL ERROR: MPU6050 calibration failed.");
    while (true) {
      setBuzzer(false);
      delay(1000);
    }
  }

  // Tare load cells. Model should have no payload during startup.
  Serial.println("Remove all payload from both load cells.");
  Serial.println("Taring load cells in 2 seconds...");
  delay(2000);

  leftScale.tare(20);
  rightScale.tare(20);

  leftWeightG = 0.0f;
  rightWeightG = 0.0f;
  lastLeftScaleReadMs = millis();
  lastRightScaleReadMs = millis();
  leftScaleValid = true;
  rightScaleValid = true;

  // Initial water ADC sample.
  waterRaw = readWaterRawAverage();
  lastWaterReadMs = millis();

  // Initialize alternating ultrasonic schedule.
  nextGatePing = PING_ENTRY;
  nextGatePingAtMs = millis() + 500;

  Serial.println();
  Serial.println("ALL MAIN SENSORS INITIALIZED.");

  if (waterCalibrationValid) {
    Serial.println("Water calibration: LOADED FROM FLASH.");
  } else {
    Serial.println("Water calibration required: keep sensor dry and send 'd'.");
  }

  Serial.println();
  Serial.println("SERIAL COMMANDS:");
  Serial.println("d = water sensor DRY calibration");
  Serial.println("w = water sensor WET calibration");
  Serial.println("t = tare both load cells (remove load first)");
  Serial.println("m = recalibrate MPU (model level and still)");
  Serial.println("z = reset entry, exit, and onboard passenger counts");
  Serial.println();
  Serial.println("GPS may need open sky and time to obtain a fix.");
  Serial.println("================================================");
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop() {
  // 1. Read incoming GPS characters continuously.
  updateGPS();

  // 2. Handle serial commands.
  handleSerialCommands();

  // 3. Read load cells when HX711 data is ready.
  if (leftScale.is_ready()) {
    leftWeightG = leftScale.get_units(1);
    lastLeftScaleReadMs = millis();
  }

  if (rightScale.is_ready()) {
    rightWeightG = rightScale.get_units(1);
    lastRightScaleReadMs = millis();
  }

  leftScaleValid = (millis() - lastLeftScaleReadMs < 1500UL);
  rightScaleValid = (millis() - lastRightScaleReadMs < 1500UL);

  if (fabs(leftWeightG) < WEIGHT_ZERO_DEADBAND_G) leftWeightG = 0.0f;
  if (fabs(rightWeightG) < WEIGHT_ZERO_DEADBAND_G) rightWeightG = 0.0f;

  // 4. Read MPU6050.
  updateMPU();

  // 5. Read internal water sensor at its scheduled interval.
  updateWaterSensor();

  // 6. Read entry/exit HC-SR04 sensors in alternating slots.
  updatePassengerGates();

  // 7. Calculate alert conditions for buzzer.
  const float totalWeightG = leftWeightG + rightWeightG;
  const float differenceG = fabs(leftWeightG - rightWeightG);

  const bool validDistribution =
      leftScaleValid && rightScaleValid &&
      leftWeightG >= 0.0f && rightWeightG >= 0.0f &&
      totalWeightG >= NO_LOAD_THRESHOLD_G;

  float imbalancePercent = 0.0f;
  if (validDistribution) {
    imbalancePercent = (differenceG / totalWeightG) * 100.0f;
  }

  const bool capacityReached = leftScaleValid && rightScaleValid &&
      (leftWeightG >= LOAD_CELL_CAPACITY_G ||
       rightWeightG >= LOAD_CELL_CAPACITY_G);

  const bool nearCapacity = leftScaleValid && rightScaleValid &&
      (leftWeightG >= LOAD_CELL_WARNING_G ||
       rightWeightG >= LOAD_CELL_WARNING_G);

  const bool detectedWater = waterCalibrationValid &&
      (waterCoveragePercent >= WATER_DETECT_PERCENT);

  const bool warningWater = waterCalibrationValid &&
      (waterCoveragePercent >= WATER_WARNING_PERCENT);

  const bool criticalWater = waterCalibrationValid &&
      (waterCoveragePercent >= WATER_CRITICAL_PERCENT);

  const bool warningTilt = mpuValid &&
      (fabs(rollDeg) >= TILT_WARNING_DEG ||
       fabs(pitchDeg) >= TILT_WARNING_DEG);

  const bool criticalTilt = mpuValid &&
      (fabs(rollDeg) >= TILT_CRITICAL_DEG ||
       fabs(pitchDeg) >= TILT_CRITICAL_DEG);

  const bool warningImbalance = validDistribution &&
      (imbalancePercent >= IMBALANCE_WARNING_PERCENT);

  const bool criticalImbalance = validDistribution &&
      (imbalancePercent >= IMBALANCE_CRITICAL_PERCENT);

  const bool criticalAlert = criticalWater || criticalTilt ||
      criticalImbalance || capacityReached;

  const bool warningAlert = warningWater || warningTilt ||
      warningImbalance || nearCapacity;

  // 8. Update buzzer without blocking the other sensors.
  updateBuzzer(criticalAlert, warningAlert, detectedWater);

  // 9. Print a complete monitoring report once per second.
  printMonitoringData();

  // Small loop delay; GPS parsing continues on every iteration.
  delay(2);
}
